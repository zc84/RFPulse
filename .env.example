# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rfpulse

# JWT secret for auth tokens (generate a strong random string)
JWT_SECRET=change-me-to-a-secure-random-string

# Server port
PORT=3000

# Uploaded document storage. Use a persistent disk path in production.
UPLOAD_DIR=server/uploads

# Comma-separated list of origins allowed to call the API cross-origin.
# Leave empty when the SPA and API share an origin (the production default).
# In development, an empty value allows all origins so Vite (port 5001) can reach the API.
# Example: CORS_ALLOWED_ORIGINS=https://rfpulse.example.com,http://localhost:5001
CORS_ALLOWED_ORIGINS=

# Public visual endpoint. Authentication is intentionally not required.
ENDPOINT_VISUALS_ENABLED=true
ENDPOINT_VISUAL_TIMEOUT_MS=300000
ENDPOINT_VISUAL_BODY_LIMIT=1mb
ENDPOINT_VISUAL_PLAN_RATE_LIMIT=20
ENDPOINT_VISUAL_RENDER_RATE_LIMIT=10
ENDPOINT_VISUAL_RATE_WINDOW_MS=900000
ENDPOINT_VISUAL_MAX_CONCURRENT=2
ENDPOINT_VISUAL_DEPLOYMENT_MODE=single-instance
ENDPOINT_VISUAL_PROVIDER_MAX_CONCURRENT=2
ENDPOINT_VISUAL_PROVIDER_LEASE_TTL_SECONDS=330
ENDPOINT_VISUAL_IMAGE_MAX_RETRIES=1
ENDPOINT_VISUAL_ARCHITECTURE_RENDERER=shared
ENDPOINT_VISUAL_PLANNER_MODEL=gpt-4.1-mini
ENDPOINT_VISUAL_MAX_PLANNER_PROMPT_BYTES=262144
ENDPOINT_VISUAL_MAX_RENDER_INPUT_BYTES=65536
ENDPOINT_VISUAL_MAX_ARTIFACT_BYTES=3145728
ENDPOINT_VISUAL_MAX_OUTPUT_BYTES=6291456
ENDPOINT_VISUAL_MAX_IDEMPOTENCY_RESPONSE_BYTES=12582912
ENDPOINT_VISUAL_MAX_PIXEL_AREA=3500000

# Public visual endpoint hourly budgets.
ENDPOINT_VISUAL_HOURLY_PLANNER_LIMIT=40
ENDPOINT_VISUAL_HOURLY_IMAGE_LIMIT=10
ENDPOINT_VISUAL_HOURLY_QA_LIMIT=20
ENDPOINT_VISUAL_HOURLY_REGENERATION_LIMIT=10
ENDPOINT_VISUAL_HOURLY_COST_UNITS=200

# Public visual endpoint daily budgets.
ENDPOINT_VISUAL_DAILY_PLANNER_LIMIT=200
ENDPOINT_VISUAL_DAILY_IMAGE_LIMIT=50
ENDPOINT_VISUAL_DAILY_QA_LIMIT=100
ENDPOINT_VISUAL_DAILY_REGENERATION_LIMIT=50
ENDPOINT_VISUAL_DAILY_COST_UNITS=1000
