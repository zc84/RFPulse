# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rfpulse

# JWT secret for auth tokens (generate a strong random string)
JWT_SECRET=change-me-to-a-secure-random-string

# Server port
PORT=3000

# Uploaded document storage. Use a persistent disk path in production.
UPLOAD_DIR=server/uploads

# Comma-separated list of origins allowed to call the API cross-origin.
# Leave empty when the SPA and API share an origin (the production default).
# In development, an empty value allows all origins so Vite (port 5001) can reach the API.
# Example: CORS_ALLOWED_ORIGINS=https://rfpulse.example.com,http://localhost:5001
CORS_ALLOWED_ORIGINS=
