{
  "name": "rfpulse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run dev:frontend\"",
    "dev:frontend": "vite --host 0.0.0.0 --port 5001",
    "build": "tsc -b && vite build",
    "test": "node --test server/tests/*.test.js",
    "benchmark:phase2-planner": "node server/scripts/phase2PlannerBenchmark.js",
    "benchmark:phase4-knowledge": "node server/scripts/phase4KnowledgeRetrievalBenchmark.js",
    "benchmark:phase1-requirements": "node server/scripts/phase1RequirementsBenchmark.js",
    "benchmark:release-gate": "node server/scripts/phase7ReleaseGate.js",
    "benchmark:runtime-comparison": "node server/scripts/compareRuntimeReports.js",
    "pilot:readiness": "node server/scripts/pilotReadiness.js",
    "benchmark:validate-golden": "node server/scripts/validateGoldenBenchmark.js",
    "python:deps": "python3 -m pip install -r server/scripts/requirements.txt --target server/scripts/.pydeps --upgrade",
    "db:setup": "node server/scripts/setupDatabase.js",
    "db:verify": "node server/scripts/verifyDatabase.js",
    "db:seed": "node server/seed.js",
    "render:build": "npm ci --include=dev --cache .npm-cache && npm run python:deps && npm run build",
    "render:predeploy": "npm run db:setup && npm run db:seed",
    "render:start": "NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "dev:full": "concurrently \"npm run server:dev\" \"npm run dev:frontend\""
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@resvg/resvg-js": "^2.6.2",
    "apexgantt-skill": "^1.3.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.12",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "openai": "^6.44.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.0.227",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.27.1",
    "svgdom": "^0.1.23",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/multer": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
